<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (ChatGPT)">
  <diagram id="WearTwinArchitecture6Box" name="WearTwin Architecture">
    <mxGraphModel dx="1664" dy="924" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1667" pageHeight="895" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Georgia;fontSize=27;fontStyle=1;" value="&lt;div style=&quot;font-family:Georgia,serif;font-size:27px;font-weight:bold;text-align:center;color:#111111;&quot;&gt;WEARTWIN SYSTEM ARCHITECTURE &amp;amp; PIPELINE&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="950" x="360" y="23" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="rounded=0;html=1;strokeColor=none;fillColor=#e60000;" value="" vertex="1">
          <mxGeometry height="3" width="438" x="620" y="64" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Georgia;fontSize=14;fontStyle=1;" value="&lt;div style=&quot;font-family: Georgia, serif; font-size: 14px; font-weight: bold; text-align: center; color: rgb(23, 54, 93);&quot;&gt;WHERE DATA IS PROCESSED: Cloud Server (FastAPI / Python) OR Web Dashboard (Client-Side JS) Depending on Load&lt;/div&gt;" vertex="1">
          <mxGeometry height="28" width="900" x="389" y="78" as="geometry" />
        </mxCell>
        <mxCell id="module1" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EEF6E9;strokeColor=#70AD61;strokeWidth=1.6;align=left;verticalAlign=top;spacing=11;fontFamily=Georgia;fontSize=13;" value="&lt;div style=&quot;padding:2px 3px 0 3px;&quot;&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:19px;font-weight:bold;line-height:1.12;text-align:center;color:#111111;padding:0 0 9px 0;margin:0 0 10px 0;border-bottom:1px solid #d6d6d6;&quot;&gt;Wearable Sensor&lt;br/&gt;Node (On-Body)&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;ECG Sensor:&lt;/b&gt; AD8232 / ADS1292R reads cardiac biopotentials (250 Hz R-peaks).&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;PPG &amp;amp; SpO₂:&lt;/b&gt; MAX30102 / MAX86150 reads optical Red &amp;amp; IR blood volume pulse (100 Hz).&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Motion (IMU):&lt;/b&gt; MPU6050 / ICM-20948 reads 3-axis acceleration &amp;amp; gyro kinematics.&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Thermal &amp;amp; Resp:&lt;/b&gt; MLX90614 / MAX30205 skin temp, stretch belt &amp;amp; ambient temp/RH.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="325" width="246" x="33" y="135" as="geometry" />
        </mxCell>
        <mxCell id="module2" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#FDF0F0;strokeColor=#E56B6B;strokeWidth=1.6;align=left;verticalAlign=top;spacing=11;fontFamily=Georgia;fontSize=13;" value="&lt;div style=&quot;padding:2px 3px 0 3px;&quot;&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 19px; font-weight: bold; line-height: 1.12; text-align: center; color: rgb(17, 17, 17); padding: 0px 0px 9px; margin: 0px 0px 10px; border-bottom: 1px solid rgb(214, 214, 214);&quot;&gt;Data Acquisition,&lt;br&gt;Signal Processing&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 12.9px; line-height: 1.24; text-align: left; margin: 0px 0px 8px; color: rgb(34, 34, 34);&quot;&gt;•&amp;nbsp; &lt;b&gt;ESP32 MCU:&lt;/b&gt;&amp;nbsp;Multi-rate sensor acquisition (I²C / SPI / ADC).&lt;/div&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 12.9px; line-height: 1.24; text-align: left; margin: 0px 0px 8px; color: rgb(34, 34, 34);&quot;&gt;•&amp;nbsp; &lt;b&gt;Edge DSP:&lt;/b&gt; Bandpass/Notch filtering, R-peak BPM, Kalman orientation &amp;amp; 2-Ch Conv Autoencoder PPG denoising.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="325" width="246" x="306" y="135" as="geometry" />
        </mxCell>
        <mxCell id="module3" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EEF6E9;strokeColor=#70AD61;strokeWidth=1.6;align=left;verticalAlign=top;spacing=11;fontFamily=Georgia;fontSize=13;" value="&lt;div style=&quot;padding:2px 3px 0 3px;&quot;&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 19px; font-weight: bold; line-height: 1.12; text-align: center; color: rgb(17, 17, 17); padding: 0px 0px 9px; margin: 0px 0px 10px; border-bottom: 1px solid rgb(214, 214, 214);&quot;&gt;Wireless Comm&lt;br&gt;(Wi-Fi / BLE)&lt;/div&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 12.9px; line-height: 1.24; text-align: left; margin: 0px 0px 8px; color: rgb(34, 34, 34);&quot;&gt;•&amp;nbsp; &lt;b&gt;Wi-Fi Telemetry:&lt;/b&gt; ESP32 802.11 b/g/n sends batched JSON packets (~200 ms / 5 Hz).&lt;/div&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 12.9px; line-height: 1.24; text-align: left; margin: 0px 0px 8px; color: rgb(34, 34, 34);&quot;&gt;•&amp;nbsp; &lt;b&gt;Bluetooth (BLE):&lt;/b&gt; Low-power short-range relay to field gateway or mobile hub.&lt;/div&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 12.9px; line-height: 1.24; text-align: left; margin: 0px 0px 8px; color: rgb(34, 34, 34);&quot;&gt;•&amp;nbsp; &lt;b&gt;Transport Protocols:&lt;/b&gt; Non-blocking HTTP POST (&lt;code&gt;/api/readings/batch&lt;/code&gt;), MQTT &amp;amp; live WebSockets (&lt;code&gt;/ws/live&lt;/code&gt;).&lt;/div&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 12.9px; line-height: 1.24; text-align: left; margin: 0px 0px 8px; color: rgb(34, 34, 34);&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="325" width="246" x="579" y="135" as="geometry" />
        </mxCell>
        <mxCell id="module4" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EEF6E9;strokeColor=#70AD61;strokeWidth=1.6;align=left;verticalAlign=top;spacing=11;fontFamily=Georgia;fontSize=13;" value="&lt;div style=&quot;padding:2px 3px 0 3px;&quot;&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:19px;font-weight:bold;line-height:1.12;text-align:center;color:#111111;padding:0 0 9px 0;margin:0 0 10px 0;border-bottom:1px solid #d6d6d6;&quot;&gt;Causal Feature&lt;br/&gt;Engine&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Dual-Target Execution:&lt;/b&gt; Runs on &lt;b&gt;Cloud Server&lt;/b&gt; (&lt;code&gt;features.py&lt;/code&gt;) or &lt;b&gt;Web Dashboard&lt;/b&gt; (&lt;code&gt;twin_engine.js&lt;/code&gt;) based on load.&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;34 Streaming Features:&lt;/b&gt; Extracted causally per 30s window with zero look-ahead.&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Baseline Deviations:&lt;/b&gt; ΔHR, RMSSD log-ratio, ΔSkin Temp, ΔSpO₂, ΔRR + 3m/10m medians.&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Strain Proxies:&lt;/b&gt; Cardiac drift (&lt;code&gt;hr_per_imu&lt;/code&gt;), &lt;code&gt;active_min&lt;/code&gt; &amp;amp; Apparent Temp.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="325" width="246" x="851" y="135" as="geometry" />
        </mxCell>
        <mxCell id="module5" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#FDF0F0;strokeColor=#E56B6B;strokeWidth=1.6;align=left;verticalAlign=top;spacing=11;fontFamily=Georgia;fontSize=13;" value="&lt;div style=&quot;padding:2px 3px 0 3px;&quot;&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:19px;font-weight:bold;line-height:1.12;text-align:center;color:#111111;padding:0 0 9px 0;margin:0 0 10px 0;border-bottom:1px solid #d6d6d6;&quot;&gt;AI State &amp;amp;&lt;br/&gt;Twin Engine&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Load-Adaptive Inference:&lt;/b&gt; Evaluates on &lt;b&gt;Cloud Server&lt;/b&gt; (multi-squad batch) or &lt;b&gt;Browser Client&lt;/b&gt; (~15 ms offline/edge mode).&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Models:&lt;/b&gt; HistGradientBoosting Classifier &amp;amp; Regressors (25% sensor-loss aug.).&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Outputs:&lt;/b&gt; 4 States (Normal, Fatigue, Thermal, Cardio) + Readiness Score (0–100).&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Stability:&lt;/b&gt; EMA smoothing (α=0.35) + 3-window (90s) state debounce.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="325" width="246" x="1124" y="135" as="geometry" />
        </mxCell>
        <mxCell id="module6" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EEF6E9;strokeColor=#70AD61;strokeWidth=1.6;align=left;verticalAlign=top;spacing=11;fontFamily=Georgia;fontSize=13;" value="&lt;div style=&quot;padding:2px 3px 0 3px;&quot;&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:19px;font-weight:bold;line-height:1.12;text-align:center;color:#111111;padding:0 0 9px 0;margin:0 0 10px 0;border-bottom:1px solid #d6d6d6;&quot;&gt;Web Dashboard&lt;br/&gt;&amp;amp; Triage HUD&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Destination Client:&lt;/b&gt; Live telemetry &amp;amp; twin state received on the &lt;b&gt;Web Dashboard&lt;/b&gt; via WebSockets / REST.&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;3D Hologram HUD:&lt;/b&gt; 60 FPS wireframe with dynamic fluid fill (100% full → 0% empty).&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Readiness Bands:&lt;/b&gt; Ready (≥75), Caution (50–74), Rest / Rotate (&amp;lt;50).&lt;/div&gt;&lt;div style=&quot;font-family:Georgia,serif;font-size:12.9px;line-height:1.24;text-align:left;margin:0 0 8px 0;color:#222222;&quot;&gt;•&amp;nbsp; &lt;b&gt;Command &amp;amp; Triage:&lt;/b&gt; Squad telemetry replay, sandbox sliders &amp;amp; medic priority alerts.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="325" width="246" x="1396" y="135" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="shape=chevron;html=1;whiteSpace=wrap;fillColor=#D90000;strokeColor=#D90000;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="48" width="22" x="281" y="315" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="shape=chevron;html=1;whiteSpace=wrap;fillColor=#D90000;strokeColor=#D90000;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="48" width="22" x="554" y="315" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="1" style="shape=chevron;html=1;whiteSpace=wrap;fillColor=#D90000;strokeColor=#D90000;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="48" width="22" x="827" y="315" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="1" style="shape=chevron;html=1;whiteSpace=wrap;fillColor=#D90000;strokeColor=#D90000;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="48" width="22" x="1100" y="315" as="geometry" />
        </mxCell>
        <mxCell id="16" parent="1" style="shape=chevron;html=1;whiteSpace=wrap;fillColor=#D90000;strokeColor=#D90000;strokeWidth=1;" value="" vertex="1">
          <mxGeometry height="48" width="22" x="1372" y="315" as="geometry" />
        </mxCell>
        <mxCell id="17" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EEF5FD;strokeColor=#6D99D4;strokeWidth=1.7;align=left;verticalAlign=top;spacing=16;fontFamily=Georgia;fontSize=13;" value="&lt;div style=&quot;padding:2px 3px 0 3px;&quot;&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 18px; font-weight: bold; line-height: 1.12; text-align: center; color: rgb(17, 17, 17); padding: 0px 0px 7px; margin: 0px 0px 8px; border-bottom: 1px solid rgb(214, 220, 229);&quot;&gt;Wireless Telemetry Transport (Wi-Fi / BLE), Time-Sync &amp;amp; Baseline&lt;br&gt;Calibration&lt;/div&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 13px; line-height: 1.24; text-align: left; margin: 0px 0px 7px; color: rgb(34, 34, 34);&quot;&gt;•&amp;nbsp; &lt;b&gt;Communication Link (How Data is Sent):&lt;/b&gt; ESP32 transmits multi-rate sensor streams via &lt;b&gt;Wi-Fi&lt;/b&gt; (HTTP POST batches / MQTT / WebSockets) or &lt;b&gt;Bluetooth (BLE)&lt;/b&gt; into SQLite WAL &amp;amp; the Web Dashboard with reboot-epoch isolation.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="735" x="80" y="490" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;overflow=hidden;fillColor=#EEF5FD;strokeColor=#6D99D4;strokeWidth=1.7;align=left;verticalAlign=top;spacing=16;fontFamily=Georgia;fontSize=13;" value="&lt;div style=&quot;padding:2px 3px 0 3px;&quot;&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 18px; font-weight: bold; line-height: 1.12; text-align: center; color: rgb(17, 17, 17); padding: 0px 0px 7px; margin: 0px 0px 8px; border-bottom: 1px solid rgb(214, 220, 229);&quot;&gt;Load-Adaptive Hybrid Processing (Cloud Server vs. Web Dashboard)&lt;br&gt;&amp;amp; Verification&lt;/div&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 12.8px; line-height: 1.24; text-align: left; margin: 0px 0px 7px; color: rgb(34, 34, 34);&quot;&gt;•&amp;nbsp; &lt;b&gt;Where Data is Processed (Load-Dependent):&lt;/b&gt; Under normal squad operations, the &lt;b&gt;Web Dashboard&lt;/b&gt;&amp;nbsp;(Python / FastAPI) runs DSP &amp;amp; AI inference; under high server load, high latency, or disconnected field ops, processing offloads directly to the &lt;b&gt;Cloud&lt;/b&gt;&amp;nbsp;(&lt;code&gt;twin_engine.js&lt;/code&gt;).&lt;/div&gt;&lt;div style=&quot;font-family: Georgia, serif; font-size: 12.8px; line-height: 1.24; text-align: left; margin: 0px 0px 7px; color: rgb(34, 34, 34);&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="735" x="860" y="490" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
